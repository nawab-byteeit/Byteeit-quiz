# VITE_SUPABASE_URL: Your Supabase project URL (Project Settings -> API).
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# VITE_SUPABASE_ANON_KEY: Your Supabase anon/publishable key (Project Settings -> API).
# Safe to expose to the browser -- access is enforced by Postgres Row Level Security.
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
